<?xml version="1.0" encoding="UTF-8"?>
<!--
  Basic sitemap covering the site's static pages. Individual news
  articles live in Supabase (news_articles table) and are served
  dynamically at /article/?slug=..., so they can't be listed here
  by hand. If you want every article included for search/AdSense
  crawling, the easiest options are:
    1) Add each article's URL manually below as you publish it, or
    2) Generate this file automatically with a small script that
       queries `select slug, published_at from news_articles where
       status = 'published'` and writes one <url> block per row.
  Either way, keep this file at the domain root as sitemap.xml.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://gakoromedia.rw/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://gakoromedia.rw/studio/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://gakoromedia.rw/privacy/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://gakoromedia.rw/terms/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
